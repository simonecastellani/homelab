services:
  homeassistant:
    container_name: homeassistant
    image: {{ homeassistant_docker_image | default('ghcr.io/home-assistant/home-assistant:stable') }}
    volumes:
      - /opt/homeassistant/config:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    privileged: true
    network_mode: host
